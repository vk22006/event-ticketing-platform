# EventPro Rust Backend Configuration (Local Development)
# Duplicate this file to .env and provide your local credentials.

# Application Environment (development | production | test)
APP_ENV=development

# Server Network Configuration
HOST=127.0.0.1
PORT=3001

# MySQL Database Connection URL (Recommended)
# Format: mysql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=mysql://db_user:db_password@localhost:3306/event_lifecycle

# Alternative: Discrete MySQL Connection Variables (Fallback)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=event_lifecycle

# Session Encryption Key (Minimum 16 characters)
SESSION_SECRET=your_32_character_secret_key_here_12345

# Static Assets Directory (Relative to cargo working directory or absolute)
PUBLIC_DIR=../public
